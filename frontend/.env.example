# Copy to frontend/.env and fill in. These are built into the app, so only
# public values belong here. Never put SERVICE_KEY or DATABASE_URL here.
EXPO_PUBLIC_API_URL=https://api.tallyhomeschool.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The anon (public) key, the same as SUPABASE_KEY in the root .env.
EXPO_PUBLIC_SUPABASE_KEY=
